# evcc: the tool only reads (GET /api/sessions and /api/state)
EVCC_URL=https://evcc.example.org
# Vehicle title in evcc. More than one title (after a rename): "Old title,New title"
EVCC_VEHICLE="Company car"
VEHICLE_LABEL="Polestar 2 (AB-123-C)"
# Optional: RFID tags of the company car, to find sessions with the wrong vehicle
EVCC_IDENTIFIERS=

# Price basis: "evcc" (the value that evcc recorded) or "agreed" (kWh x a fixed agreed tariff)
PRICE_BASIS=evcc
# Reference to the written agreement, shown on the statement. Necessary for "agreed", optional for "evcc"
# Example: "de laadstroomovereenkomst van 1 januari 2027"
AGREEMENT_REF=
# Only for "agreed": start date and price per kWh; add an entry when the price changes
AGREED_TARIFFS=

# Statement
CLAIMANT_NAME="A. Person"
CLAIMANT_ADDRESS="Street 1\n1234 AB Town"
# Your own IBAN; the tool checks its control number
CLAIMANT_IBAN=
PAYER_NAME="Example Holding B.V."
PAYER_ADDRESS="Street 2\n1234 AB Town"

# Email (SMTP_PORT 465 = TLS, other ports = STARTTLS)
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_CC=
# Optional: gets a message when a scheduled run fails
ALERT_TO=

OUTPUT_DIR=/data
# Optional: folder for the markers that say what was sent (default: OUTPUT_DIR). Do not delete these files.
# When you set it later, the tool also reads the old markers in OUTPUT_DIR. It does not move them
STATE_DIR=
BILLING_TZ=Europe/Amsterdam

# Schedule (--schedule): the previous month is due from RUN_DAY, runs are at RUN_AT (a time in BILLING_TZ)
RUN_DAY=2
RUN_AT=07:00
# Optional: first month to send (YYYY-MM); months from here on are sent until they are done.
# Default: the month before the first start, kept in the file first-period in STATE_DIR (or OUTPUT_DIR)
FIRST_PERIOD=
# Optional: "true" sends also when a session has no vehicle or a car is still connected.
# Risk: the session of a car that is connected at the month end is then in no statement
ALLOW_INCOMPLETE=false
# Optional: a recovery action that --schedule does one time only at its start: none, resend or mark_sent.
# resend is the same as --force, mark_sent is the same as --mark-sent. A failed action does not run again.
# ACTION=none clears the stored request and is the normal state.
# To do the same action again, change ACTION_ID (for example from empty to 2) and restart one time.
# Before you ask resend again, always look in the mailboxes if the statement arrived. See the README.
# After a send that stopped halfway, look in the mailbox of the recipients:
# - All recipients have the statement: use mark_sent.
# - No recipient has the statement: use resend.
# - Some recipients have the statement: send the PDF to the others by hand, then use mark_sent.
ACTION=none
# The month of the action (YYYY-MM)
ACTION_PERIOD=
# Optional: a free id of the request, at most 32 characters of A-Z, a-z, 0-9, ".", "_" and "-".
# A different id makes the same action and month a new request. Default: empty
ACTION_ID=
